local trackedHealth = {}

task.spawn(function()
    while true do
        pcall(function()
            for _, targetName in ipairs(protectedNames) do
                local targetPlayer = Players:FindFirstChild(targetName)
                if targetPlayer and targetPlayer.Character then
                    local humanoid = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
                    if humanoid then
                        if not trackedHealth[targetName] then
                            trackedHealth[targetName] = humanoid.Health
                        end
                        
                        local damageTaken = trackedHealth[targetName] - humanoid.Health
                        
                        if damageTaken >= 20 then
                            trackedHealth[targetName] = humanoid.Health
                            
                            for _, p in ipairs(Players:GetPlayers()) do
                                if p ~= targetPlayer and p.Character and p.Character:FindFirstChild("Humanoid") then
                                    local pHead = p.Character:FindFirstChild("Head")
                                    if pHead and targetPlayer.Character:FindFirstChild("Head") then
                                        local distance = (pHead.Position - targetPlayer.Character.Head.Position).Magnitude
                                        if distance < 20 then
                                            p:Kick("คุณทำดาเมจใส่เจ้าของสคริปต์เกิน 20 หน่วย จึงถูกเซิร์ฟเวอร์เตะออก")
                                        end
                                    end
                                end
                            end
                        elseif humanoid.Health > trackedHealth[targetName] then
                            trackedHealth[targetName] = humanoid.Health
                        end
                    end
                end
            end
        end)
        task.wait(0.2)
    end
end)

local function getHealthColor(health)
    if health >= 60 then
        return Color3.fromRGB(0, 255, 0)
    elseif health >= 30 then
        return Color3.fromRGB(255, 255, 0)
    else
        return Color3.fromRGB(255, 0, 0)
    end
end

local function createBox()
    local box = Drawing.new("Square")
    box.Thickness = 2
    box.Transparency = 1
    box.Filled = false
    box.Visible = false
    return box
end

local boxes = {}
for _, player in ipairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then
        boxes[player] = createBox()
    end
end

Players.PlayerAdded:Connect(function(player)
    if player ~= LocalPlayer then
        boxes[player] = createBox()
    end
end)

Players.PlayerRemoving:Connect(function(player)
    if boxes[player] then
        boxes[player]:Remove()
        boxes[player] = nil
    end
end)

local CurrentTarget = nil

RunService.RenderStepped:Connect(function()
    FOVFrame.Size = UDim2.new(0, AimbotSettings.FOV * 2, 0, AimbotSettings.FOV * 2)
    FOVFrame.Visible = AimbotSettings.ShowFOV and AimbotSettings.Enabled

    if LocalPlayer.Character then
        local myHumanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if myHumanoid then
            if AimbotSettings.HideMyNameOnly then
                myHumanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
            else
                myHumanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
            end
        end
        for _, descendant in ipairs(LocalPlayer.Character:GetDescendants()) do
            if descendant:IsA("BillboardGui") and descendant.Name ~= "ItemESP" then
                descendant.Enabled = not AimbotSettings.HideMyNameOnly
            end
        end
    end

    for player, box in pairs(boxes) do
        local character = player.Character
        if character and character:FindFirstChild("HumanoidRootPart") and character:FindFirstChild("Humanoid") then
            local root = character.HumanoidRootPart
            local hum = character.Humanoid
            local pos, onScreen = Camera:WorldToViewportPoint(root.Position)

            if onScreen and hum.Health > 0 then
                local headPos = Camera:WorldToViewportPoint(root.Position + Vector3.new(0, 3, 0))
                local legPos = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))
                local height = math.abs(headPos.Y - legPos.Y)
                local width = height / 2

                box.Size = Vector2.new(width, height)
                box.Position = Vector2.new(pos.X - width / 2, pos.Y - height / 2)
                box.Color = getHealthColor(hum.Health)
                box.Visible = true
            else
                box.Visible = false
            end
        else
            box.Visible = false
        end
    end

    local shouldLock = AimbotSettings.Enabled and AimbotSettings.IsAiming

    if shouldLock then
        FOVStroke.Color = Color3.fromRGB(50, 255, 50)
        
        if AimbotSettings.StrongLock then
            if not isTargetValid(CurrentTarget) then
                CurrentTarget = getClosestTarget()
            end
        else
            CurrentTarget = getClosestTarget()
        end

        if CurrentTarget then
            local targetPos = CurrentTarget.Position
            
            -- ชดเชยตำแหน่งเล็งลงเล็กน้อยเมื่อเราอยู่บนรถ
            local myHumanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if myHumanoid and myHumanoid.SeatPart then
                targetPos = targetPos - Vector3.new(0, 0.6, 0) 
            end

            Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPos)
        end
    else
        FOVStroke.Color = Color3.fromRGB(255, 50, 50)
        CurrentTarget = nil
    end
end)

