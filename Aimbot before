local function refreshPlayerList()
    for _, child in ipairs(ScrollingContainer:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local pBtn = Instance.new("TextButton", ScrollingContainer)
            pBtn.Size = UDim2.new(1, 0, 0, 35)
            pBtn.Font = Enum.Font.SourceSansBold
            pBtn.TextSize = 14
            Instance.new("UICorner", pBtn).CornerRadius = UDim.new(0, 6)
            
            local isExcluded = table.find(AimbotSettings.ExcludedPlayers, player.UserId) ~= nil
            if isExcluded then
                pBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
                pBtn.Text = "ไม่ล็อค 🟢 [Excluded] " .. player.Name
                pBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            else
                pBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
                pBtn.Text = "ล็อค 🔴 " .. player.Name
                pBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
            end
            
            pBtn.MouseButton1Click:Connect(function()
                local idx = table.find(AimbotSettings.ExcludedPlayers, player.UserId)
                if idx then
                    table.remove(AimbotSettings.ExcludedPlayers, idx)
                else
                    table.insert(AimbotSettings.ExcludedPlayers, player.UserId)
                end
                refreshPlayerList()
            end)
        end
    end
    ScrollingContainer.CanvasSize = UDim2.new(0, 0, 0, UIList.AbsoluteContentSize.Y)
end

ExcludeBtn.MouseButton1Click:Connect(function()
