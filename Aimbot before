local ItemGui = Instance.new("ScreenGui", CoreGui)
ItemGui.Name = "ItemESP_ScreenGui"
ItemGui.IgnoreGuiInset = true

local ItemFrames = {}

local function createPlayerItemContainer(player)
    if player == LocalPlayer or ItemFrames[player] then return end

    local containerFrame = Instance.new("Frame", ItemGui)
    containerFrame.Name = "ItemContainer_" .. player.Name
    containerFrame.Size = UDim2.new(0, 200, 0, 150)
    containerFrame.AnchorPoint = Vector2.new(0.5, 0) -- จุดอ้างอิงอยู่ตรงกลางด้านบน เพื่อเรียงลงล่างจากใต้เท้า
    containerFrame.BackgroundTransparency = 1
    containerFrame.Visible = false

    local layout = Instance.new("UIListLayout", containerFrame)
    layout.Padding = UDim.new(0, 1)
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    layout.VerticalAlignment = Enum.VerticalAlignment.Top
    layout.SortOrder = Enum.SortOrder.LayoutOrder

    ItemFrames[player] = {
        Frame = containerFrame,
        Tools = {}
    }

    local function updateItems()
        if not ItemESP_Enabled or not ItemFrames[player] then return end
        local frame = ItemFrames[player].Frame
        for _, child in ipairs(frame:GetChildren()) do
            if child:IsA("TextLabel") then child:Destroy() end
        end

        local currentTools = {}
        local function scan(folder)
            if not folder then return end
            for _, tool in ipairs(folder:GetChildren()) do
                if tool:IsA("Tool") and tool.Name ~= "Fists" then
                    local info = getWeaponInfo(tool)
                    if info then table.insert(currentTools, info) end
                end
            end
        end

        local char = player.Character
        if char then
            scan(char)
            local backpack = player:FindFirstChild("Backpack")
            if backpack then scan(backpack) end
        end

        for i, info in ipairs(currentTools) do
            local txt = Instance.new("TextLabel")
            txt.Parent = frame
            txt.Size = UDim2.new(1, 0, 0, 13)
            txt.BackgroundTransparency = 1
            txt.Font = Enum.Font.SourceSansBold
            txt.TextSize = 11
            txt.Text = "[" .. tostring(info.Name) .. "]"
            txt.LayoutOrder = i

            local color = RARITY_COLORS[info.Rarity] or Color3.fromRGB(255, 255, 255)
            txt.TextColor3 = color
            
            local stroke = Instance.new("UIStroke")
            stroke.Color = Color3.fromRGB(0, 0, 0)
            stroke.Thickness = 1.5
            stroke.Parent = txt
        end
    end

    local function bindCharacter(char)
        if not char then return end
        updateItems()
        local backpack = player:FindFirstChild("Backpack")
        if backpack then
            backpack.ChildAdded:Connect(updateItems)
            backpack.ChildRemoved:Connect(updateItems)
        end
        char.ChildAdded:Connect(function(child)
            if child:IsA("Tool") then task.defer(updateItems) end
        end)
        char.ChildRemoved:Connect(function(child)
            if child:IsA("Tool") then task.defer(updateItems) end
        end)
    end

    if player.Character then bindCharacter(player.Character) end
    player.CharacterAdded:Connect(bindCharacter)
end

for _, p in ipairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then createPlayerItemContainer(p) end
end
Players.PlayerAdded:Connect(function(p)
    if p ~= LocalPlayer then createPlayerItemContainer(p) end
end)
Players.PlayerRemoving:Connect(function(p)
    if ItemFrames[p] then
        ItemFrames[p].Frame:Destroy()
        ItemFrames[p] = nil
    end
end)

-- อัปเดตตำแหน่ง Item ESP แบบ 2D หน้าจอใน RenderStepped เพื่อล็อกใต้เท้าถาวร
RunService.RenderStepped:Connect(function()
    if not ItemESP_Enabled then return end
    for player, data in pairs(ItemFrames) do
        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local root = char.HumanoidRootPart
            local hum = char:FindFirstChildOfClass("Humanoid")
            
            if hum and hum.Health > 0 then
                -- หาจุดใต้เท้าจริง ๆ ในโลก 3D (RootPartY - 3 studs)
                local footPos3D = root.Position - Vector3.new(0, 3.2, 0)
                local screenPos, onScreen = Camera:WorldToViewportPoint(footPos3D)

                if onScreen then
                    data.Frame.Position = UDim2.new(0, screenPos.X, 0, screenPos.Y)
                    data.Frame.Visible = true
                else
                    data.Frame.Visible = false
                end
            else
                data.Frame.Visible = false
            end
        else
            data.Frame.Visible = false
        end
    end
end)

