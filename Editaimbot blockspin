local function createPlayerESP(player)
    if player == LocalPlayer or ESPBillboards[player] then return end

    local headBillboard = Instance.new("BillboardGui")
    headBillboard.Name = "HeadESP_Gui"
    headBillboard.Size = UDim2.new(0, 200, 0, 25)
    -- [ปรับแก้] เพิ่มความสูงขึ้นจากเดิมเล็กน้อยเพื่อให้ดูโปร่งขึ้น
    headBillboard.StudsOffset = Vector3.new(0, 3.0, 0)
    headBillboard.AlwaysOnTop = true
    headBillboard.Enabled = false

    local nameLabel = Instance.new("TextLabel", headBillboard)
    nameLabel.Name = "NameLabel"
    nameLabel.Size = UDim2.new(1, 0, 1, 0)
    nameLabel.BackgroundTransparency = 1
    -- [ปรับแก้] เปลี่ยนฟอนต์ให้บางลง (Gotham ปกติ แทนที่จะเป็น GothamBold)
    nameLabel.Font = Enum.Font.Gotham
    -- [ปรับแก้] ลดขนาดตัวอักษรลงเหลือ 10 เพื่อความเล็กและอ่านง่าย
    nameLabel.TextSize = 9
    nameLabel.TextStrokeTransparency = 0.4
    nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)

    local footBillboard = Instance.new("BillboardGui")
    footBillboard.Name = "FootESP_Gui"
    footBillboard.Size = UDim2.new(0, 250, 0, 30)
    footBillboard.StudsOffset = Vector3.new(0, -4.0, 0)
    footBillboard.AlwaysOnTop = true
    footBillboard.Enabled = false

    local itemsLabel = Instance.new("TextLabel", footBillboard)
    itemsLabel.Name = "ItemsLabel"
    itemsLabel.Size = UDim2.new(1, 0, 1, 0)
    itemsLabel.BackgroundTransparency = 1
    itemsLabel.Font = Enum.Font.Gotham
    itemsLabel.TextSize = 9
    itemsLabel.TextStrokeTransparency = 0.2
    itemsLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    itemsLabel.TextXAlignment = Enum.TextXAlignment.Center
    itemsLabel.TextYAlignment = Enum.TextYAlignment.Center
    itemsLabel.TextWrapped = true

    ESPBillboards[player] = {
        HeadGui = headBillboard,
        FootGui = footBillboard,
        NameLbl = nameLabel,
        ItemsLbl = itemsLabel
    }

    local highlight = Instance.new("Highlight")
    highlight.Name = "PlayerHighlightESP"
    highlight.Adornee = nil
    highlight.FillTransparency = 0.65 
    highlight.OutlineTransparency = 0.2 
    highlight.FillColor = Color3.fromRGB(0, 255, 0)
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.Parent = CoreGui
    Highlights[player] = highlight

    local boxFrame = Instance.new("Frame", SafeBoxGui)
    boxFrame.BackgroundTransparency = 1
    boxFrame.Visible = false

    local boxStroke = Instance.new("UIStroke", boxFrame)
    boxStroke.Thickness = 1.5
    boxStroke.Color = Color3.fromRGB(0, 255, 0)

    SafeBoxGuiList[player] = {Frame = boxFrame, Stroke = boxStroke}

    local function updateItems()
        if not ItemESP_Enabled or not ESPBillboards[player] then return end
        
        local currentTools = {}
        local function scan(folder)
            if not folder then return end
            for _, tool in ipairs(folder:GetChildren()) do
                if tool:IsA("Tool") and tool.Name ~= "Fists" then
                    local info = getWeaponInfo(tool)
                    if info then
                        local rLower = string.lower(tostring(info.Rarity))
                        if not (HideCommonItems and (rLower == "common" or rLower == "default")) then
                            table.insert(currentTools, info)
                        end
                    end
                end
            end
        end

        local char = player.Character
        if char then
            scan(char)
            local backpack = player:FindFirstChild("Backpack")
            if backpack then scan(backpack) end
        end

        if #currentTools > 0 then
            local itemNames = {}
            for _, info in ipairs(currentTools) do
                table.insert(itemNames, "[" .. tostring(info.Name) .. "]")
            end
            itemsLabel.Text = table.concat(itemNames, " ")
            itemsLabel.TextColor3 = getRarityColor(currentTools[1].Rarity)
        else
            itemsLabel.Text = ""
        end

        local isExcluded = table.find(AimbotSettings.ExcludedPlayers, player.UserId) ~= nil
        if isExcluded then
            nameLabel.Text = player.Name .. " : team"
            nameLabel.TextColor3 = Color3.fromRGB(100, 255, 100) 
        else
            nameLabel.Text = player.Name .. " : enemy"
            nameLabel.TextColor3 = Color3.fromRGB(255, 100, 100) 
        end
    end

    local function bindCharacter(char)
        if not char then return end
        local head = char:WaitForChild("Head", 5)
        local root = char:WaitForChild("HumanoidRootPart", 5)
        
        if head then
            headBillboard.Adornee = head
            headBillboard.Parent = head
            headBillboard.Enabled = ItemESP_Enabled
        end

        if root then
            footBillboard.Adornee = root
            footBillboard.Parent = root
            footBillboard.Enabled = ItemESP_Enabled
        end

        updateItems()
        if Highlights[player] then
            Highlights[player].Adornee = char
        end
        
        local backpack = player:FindFirstChild("Backpack")
        if backpack then
            backpack.ChildAdded:Connect(updateItems)
            backpack.ChildRemoved:Connect(updateItems)
        end
        
        char.ChildAdded:Connect(function(child)
            if child:IsA("Tool") then task.defer(updateItems) end
        end)
        char.ChildRemoved:Connect(function(child)
            if child:IsA("Tool") then task.defer(updateItems) end
        end)
    end

    if player.Character then bindCharacter(player.Character) end
    player.CharacterAdded:Connect(bindCharacter)
end

for _, p in ipairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then createPlayerESP(p) end
end

Players.PlayerAdded:Connect(function(p)
    if p ~= LocalPlayer then
        task.wait(1)
        createPlayerESP(p)
    end
end)

Players.PlayerRemoving:Connect(function(player)
    if ESPBillboards[player] then
        if ESPBillboards[player].HeadGui then ESPBillboards[player].HeadGui:Destroy() end
        if ESPBillboards[player].FootGui then ESPBillboards[player].FootGui:Destroy() end
        ESPBillboards[player] = nil
    end
    if Highlights[player] then
        Highlights[player]:Destroy()
        Highlights[player] = nil
    end
    if SafeBoxGuiList[player] then
        if SafeBoxGuiList[player].Frame then SafeBoxGuiList[player].Frame:Destroy() end
        SafeBoxGuiList[player] = nil
    end
end)

RunService.RenderStepped:Connect(function()
    for player, data in pairs(ESPBillboards) do
        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Head") then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 and ItemESP_Enabled then
                data.HeadGui.Enabled = true
                data.FootGui.Enabled = true
            else
                data.HeadGui.Enabled = false
                data.FootGui.Enabled = false
            end
        else
            data.HeadGui.Enabled = false
            data.FootGui.Enabled = false
        end
    end

    for player, hl in pairs(Highlights) do
        local char = player.Character
        if char and char:FindFirstChildOfClass("Humanoid") and HighlightESP_Enabled then
            local hum = char.Humanoid
            if hum.Health > 0 then
                hl.Adornee = char
                local col = getHealthColor(hum.Health, hum.MaxHealth)
                hl.FillColor = col
                hl.OutlineColor = col
                hl.Enabled = true
            else
                hl.Enabled = false
            end
        else
            hl.Enabled = false
        end
    end

    for player, data in pairs(SafeBoxGuiList) do
        local char = player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local rootPart = char and char:FindFirstChild("HumanoidRootPart")
        
        if char and hum and rootPart and hum.Health > 0 and BoxESP_Enabled then
            local head = char:FindFirstChild("Head")
            if head then
                local headPos, headOnScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.7, 0))
                local legPos, legOnScreen = Camera:WorldToViewportPoint(rootPart.Position - Vector3.new(0, 3.5, 0))
                
                if headOnScreen or legOnScreen then
                    local height = math.abs(headPos.Y - legPos.Y)
                    local width = height / 1.5
                    
                    data.Frame.Size = UDim2.new(0, width, 0, height)
                    data.Frame.Position = UDim2.new(0, headPos.X - width / 2, 0, headPos.Y)
                    data.Stroke.Color = getHealthColor(hum.Health, hum.MaxHealth)
                    data.Frame.Visible = true
                else
                    data.Frame.Visible = false
                end
            else
                data.Frame.Visible = false
            end
        else
            data.Frame.Visible = false
        end
    end
end)

