            local function collectTools(folder)
                if not folder then return end
                for _, tool in ipairs(folder:GetChildren()) do
                    if tool:IsA("Tool") and tool.Name ~= "Fists" then
                        local info = getWeaponInfo(tool)
                        if info then
                            local rLower = string.lower(tostring(info.Rarity))
                            if not (HideCommonItems and (rLower == "common" or rLower == "default")) then
                                table.insert(foundItems, info.Name)
                            end
                        end
                    end
                end
            end
            
            if player.Character then
                collectTools(player.Character)
                local bp = player:FindFirstChild("Backpack")
                if bp then collectTools(bp) end
            end
            
            if #foundItems > 0 then
                itemsLbl.Text = table.concat(foundItems, ", ")
            else
                itemsLbl.Text = "Items: (ไม่มีไอเทมเกรดสูง)"
            end
        end
    end
