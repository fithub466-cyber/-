local RARITY_COLORS = {
    ["common"] = Color3.fromRGB(160, 160, 160),
    ["uncommon"] = Color3.fromRGB(50, 220, 50),
    ["rare"] = Color3.fromRGB(50, 150, 255),
    ["epic"] = Color3.fromRGB(180, 50, 255),
    ["legendary"] = Color3.fromRGB(255, 170, 0),
    ["default"] = Color3.fromRGB(255, 255, 255)
}

local function getRarityColor(rarityStr)
    if not rarityStr then return RARITY_COLORS["default"] end
    local lowerKey = string.lower(tostring(rarityStr))
    return RARITY_COLORS[lowerKey] or RARITY_COLORS["default"]
end

